# Which provider to use: "deepseek" or "gemini". Leave unset to
# auto-detect from whichever key below is present. Leave both keys unset
# to run in deterministic STUB mode (no network calls, no cost, no key
# required) -- the whole pipeline works without any LLM configured.
LLM_PROVIDER=

# DeepSeek V4 Flash via chat.b.ai / api.b.ai (OpenAI-compatible API).
# Get a key at https://chat.b.ai/key -- note the completions endpoint
# itself is served from api.b.ai, not chat.b.ai.
BAI_API_KEY=
BAI_BASE_URL=https://api.b.ai/v1
BAI_MODEL=deepseek-v4-flash

# Google Gemini. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
